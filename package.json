{
  "name": "cow-bird",
  "version": "0.13.1",
  "description": "把各大网页 agent 自带的沙箱 shell 包装成统一的云沙箱管理器（多平台驱动 + 免 LLM 直连执行 + 保活）",
  "bin": {
    "cowbird": "bin/cowbird.js",
    "cowbird-daemon": "bin/cowbird-daemon.js"
  },
  "files": [
    "bin/",
    "lib/",
    "commands/",
    "docs/",
    "README.md",
    "LICENSE",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/cowbird.js",
    "daemon": "node bin/cowbird-daemon.js",
    "ls": "node bin/cowbird.js ls",
    "doctor": "node bin/cowbird.js doctor",
    "test": "node test/contract.js && node test/guard.js && node test/smoke.js",
    "test:net": "node test/halfopen.js"
  },
  "author": "yanshiqwq",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshiqwq/cowbird.git"
  },
  "homepage": "https://github.com/yanshiqwq/cowbird#readme",
  "bugs": {
    "url": "https://github.com/yanshiqwq/cowbird/issues"
  },
  "optionalDependencies": {
    "playwright-core": "^1.47.0"
  },
  "keywords": [
    "workbuddy",
    "cloud-sandbox",
    "e2b",
    "acp",
    "keepalive",
    "cli",
    "daemon"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
